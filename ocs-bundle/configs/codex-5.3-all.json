{
  "$schema": "https://cdn.jsdelivr.net/gh/code-yeongyu/oh-my-opencode@master/assets/oh-my-opencode.schema.json",
  "google_auth": false,
  "disabled_hooks": ["anthropic-context-window-limit-recovery"],
  "browser_automation_engine": {
    "provider": "playwright"
  },
  "agents": {
    "sisyphus": {
      "model": "openai/gpt-5.3-codex",
      "variant": "max",
      "comment": "Main coordinator - OpenAI Codex 5.3"
    },
    "oracle": {
      "model": "openai/gpt-5.3-codex",
      "variant": "high",
      "comment": "Design & debugging - OpenAI Codex 5.3"
    },
    "librarian": {
      "model": "openai/gpt-5.3-codex",
      "comment": "Research - OpenAI Codex 5.3"
    },
    "explore": {
      "model": "openai/gpt-5.3-codex",
      "variant": "high",
      "comment": "Codebase exploration - OpenAI Codex 5.3"
    },
    "multimodal-looker": {
      "model": "openai/gpt-5.3-codex",
      "variant": "high",
      "comment": "Vision - OpenAI Codex 5.3"
    },
    "prometheus": {
      "model": "openai/gpt-5.3-codex",
      "variant": "max",
      "comment": "Architect - OpenAI Codex 5.3"
    },
    "metis": {
      "model": "openai/gpt-5.3-codex",
      "variant": "max",
      "comment": "Strategy - OpenAI Codex 5.3"
    },
    "momus": {
      "model": "openai/gpt-5.3-codex",
      "comment": "Critique - OpenAI Codex 5.3"
    },
    "atlas": {
      "model": "openai/gpt-5.3-codex",
      "variant": "high",
      "comment": "Heavy lifting - OpenAI Codex 5.3"
    },
    "executor": {
      "model": "openai/gpt-5.3-codex",
      "comment": "Fast implementation - OpenAI Codex 5.3"
    },
    "reviewer": {
      "model": "openai/gpt-5.3-codex",
      "comment": "Code review - OpenAI Codex 5.3"
    },
    "tester": {
      "model": "openai/gpt-5.3-codex",
      "comment": "Test generation - OpenAI Codex 5.3"
    },
    "security-auditor": {
      "model": "openai/gpt-5.3-codex",
      "variant": "max",
      "comment": "Security - OpenAI Codex 5.3"
    },
    "refactorer": {
      "model": "openai/gpt-5.3-codex",
      "comment": "Refactoring - OpenAI Codex 5.3"
    },
    "doc-writer": {
      "model": "openai/gpt-5.3-codex",
      "comment": "Documentation - OpenAI Codex 5.3"
    }
  },
  "lsp": {
    "rust": {
      "command": ["rust-analyzer"],
      "extensions": [".rs"]
    },
    "go": {
      "command": ["gopls"],
      "extensions": [".go"]
    },
    "markdown": {
      "command": ["marksman", "server"],
      "extensions": [".md"]
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "openai/gpt-5.3-codex",
      "comment": "UI/UX - OpenAI Codex 5.3"
    },
    "artistry": {
      "model": "openai/gpt-5.3-codex",
      "variant": "high",
      "comment": "Creative - OpenAI Codex 5.3"
    },
    "writing": {
      "model": "openai/gpt-5.3-codex",
      "comment": "Writing - OpenAI Codex 5.3"
    },
    "quick": {
      "model": "openai/gpt-5.3-codex",
      "variant": "high",
      "comment": "Fast tasks - OpenAI Codex 5.3"
    },
    "ultrabrain": {
      "model": "openai/gpt-5.3-codex",
      "variant": "max",
      "comment": "Heavy reasoning - OpenAI Codex 5.3"
    },
    "implementation": {
      "model": "openai/gpt-5.3-codex",
      "comment": "Implementation - OpenAI Codex 5.3"
    },
    "review": {
      "model": "openai/gpt-5.3-codex",
      "comment": "Review - OpenAI Codex 5.3"
    },
    "testing": {
      "model": "openai/gpt-5.3-codex",
      "comment": "Testing - OpenAI Codex 5.3"
    },
    "security": {
      "model": "openai/gpt-5.3-codex",
      "variant": "max",
      "comment": "Security - OpenAI Codex 5.3"
    },
    "unspecified-low": {
      "model": "openai/gpt-5.3-codex",
      "comment": "General low - OpenAI Codex 5.3"
    },
    "unspecified-high": {
      "model": "openai/gpt-5.3-codex",
      "comment": "General high - OpenAI Codex 5.3"
    },
    "deep": {
      "model": "openai/gpt-5.3-codex",
      "variant": "max",
      "comment": "Deep reasoning - OpenAI Codex 5.3"
    }
  },
  "impeccableStyleOverride": {
    "trigger": {
      "loadSkills": ["impeccable-style"],
      "fallbackCategory": "visual-engineering"
    },
    "antiTrigger": {
      "categories": ["implementation", "security"]
    }
  }
}
