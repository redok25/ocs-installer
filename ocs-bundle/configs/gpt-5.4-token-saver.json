{
  "$schema": "https://cdn.jsdelivr.net/gh/code-yeongyu/oh-my-opencode@master/assets/oh-my-opencode.schema.json",
  "google_auth": false,
  "disabled_hooks": ["anthropic-context-window-limit-recovery"],
  "browser_automation_engine": {
    "provider": "playwright"
  },
  "agents": {
    "sisyphus": {
      "model": "openai/gpt-5.4",
      "variant": "low",
      "comment": "Main coordinator - GPT 5.4 low"
    },
    "oracle": {
      "model": "openai/gpt-5.4",
      "variant": "high",
      "comment": "Deep analysis - GPT 5.4"
    },
    "librarian": {
      "model": "openai/gpt-5.4-mini",
      "variant": "high",
      "comment": "Research - GPT 5.4 Mini"
    },
    "explore": {
      "model": "openai/gpt-5.4-mini",
      "variant": "low",
      "comment": "Codebase exploration - GPT 5.4 Mini"
    },
    "multimodal-looker": {
      "model": "openai/gpt-5.4",
      "variant": "high",
      "comment": "Vision and interpretation - GPT 5.4"
    },
    "prometheus": {
      "model": "openai/gpt-5.4",
      "variant": "high",
      "comment": "Architecture - GPT 5.4"
    },
    "metis": {
      "model": "openai/gpt-5.4",
      "variant": "high",
      "comment": "Strategy - GPT 5.4"
    },
    "momus": {
      "model": "openai/gpt-5.4-mini",
      "variant": "high",
      "comment": "Critique and quality gate - GPT 5.4 Mini"
    },
    "atlas": {
      "model": "openai/gpt-5.4",
      "variant": "high",
      "comment": "Heavy lifting - GPT 5.4"
    },
    "hephaestus": {
      "model": "openai/gpt-5.4",
      "variant": "high",
      "comment": "Deep engineering execution - GPT 5.4"
    },
    "executor": {
      "model": "openai/gpt-5.4-mini",
      "variant": "low",
      "comment": "Implementation - GPT 5.4 Mini"
    },
    "reviewer": {
      "model": "openai/gpt-5.4",
      "variant": "low",
      "comment": "Code review - GPT 5.4 low"
    },
    "tester": {
      "model": "openai/gpt-5.4-mini",
      "variant": "low",
      "comment": "Test generation - GPT 5.4 Mini"
    },
    "security-auditor": {
      "model": "openai/gpt-5.4",
      "variant": "high",
      "comment": "Security - GPT 5.4"
    },
    "refactorer": {
      "model": "openai/gpt-5.4-mini",
      "variant": "high",
      "comment": "Refactoring - GPT 5.4 Mini"
    },
    "doc-writer": {
      "model": "openai/gpt-5.4-mini",
      "variant": "high",
      "comment": "Documentation - GPT 5.4 Mini"
    }
  },
  "lsp": {
    "rust": {
      "command": ["rust-analyzer"],
      "extensions": [".rs"]
    },
    "go": {
      "command": ["gopls"],
      "extensions": [".go"]
    },
    "markdown": {
      "command": ["marksman", "server"],
      "extensions": [".md"]
    }
  },
  "categories": {
    "visual-engineering": {
      "model": "openai/gpt-5.4",
      "variant": "low",
      "comment": "UI/UX - GPT 5.4 low"
    },
    "artistry": {
      "model": "openai/gpt-5.4-mini",
      "variant": "high",
      "comment": "Creative work - GPT 5.4 Mini"
    },
    "writing": {
      "model": "openai/gpt-5.4-mini",
      "variant": "high",
      "comment": "Writing - GPT 5.4 Mini"
    },
    "quick": {
      "model": "openai/gpt-5.4-mini",
      "variant": "low",
      "comment": "Fast tasks - GPT 5.4 Mini"
    },
    "ultrabrain": {
      "model": "openai/gpt-5.4",
      "variant": "high",
      "comment": "Heavy reasoning - GPT 5.4"
    },
    "implementation": {
      "model": "openai/gpt-5.4-mini",
      "variant": "high",
      "comment": "Implementation - GPT 5.4 Mini"
    },
    "review": {
      "model": "openai/gpt-5.4",
      "variant": "low",
      "comment": "Review - GPT 5.4 low"
    },
    "testing": {
      "model": "openai/gpt-5.4-mini",
      "variant": "low",
      "comment": "Testing - GPT 5.4 Mini"
    },
    "security": {
      "model": "openai/gpt-5.4",
      "variant": "high",
      "comment": "Security - GPT 5.4"
    },
    "unspecified-low": {
      "model": "openai/gpt-5.4-mini",
      "variant": "low",
      "comment": "General low - GPT 5.4 Mini"
    },
    "unspecified-high": {
      "model": "openai/gpt-5.4-mini",
      "variant": "high",
      "comment": "General high - GPT 5.4 Mini"
    },
    "deep": {
      "model": "openai/gpt-5.4",
      "variant": "high",
      "comment": "Deep reasoning - GPT 5.4"
    }
  },
  "impeccableStyleOverride": {
    "trigger": {
      "loadSkills": ["impeccable-style"],
      "fallbackCategory": "visual-engineering"
    },
    "antiTrigger": {
      "categories": ["implementation", "security"]
    }
  }
}

