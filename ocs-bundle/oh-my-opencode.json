  "impeccableStyleOverride": {
    "trigger": {
      "loadSkills": [
        "impeccable-style"
      ],
      "fallbackCategory": "visual-engineering"
    },
    "antiTrigger": {
      "categories": [
        "implementation",
        "security"
      ]
    }
  },
  "background_task": {
    "defaultConcurrency": 9
  }
